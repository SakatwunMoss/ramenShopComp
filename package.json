{
  "name": "ramen-compare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run generate:site-og && next build",
    "generate:site-og": "tsx scripts/generate-site-og.tsx",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "fetch-shops": "tsx --env-file=.env.local scripts/fetch-shops.ts",
    "fetch-ramen-style-images": "tsx scripts/fetch-ramen-style-images.ts"
  },
  "dependencies": {
    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "to-ico": "^1.1.5",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "wrangler": "^4.127.1"
  }
}
