# HotPepper グルメサーチ API
# https://webservice.recruit.co.jp/ で取得
HOTPEPPER_API_KEY=

# Cloudflare D1（GitHub Actions / ローカルバッチの書き込み用）
# Account ID: ダッシュボード右サイドバー
# API Token: Workers / D1 編集権限（Account → API Tokens）
# Database ID: `npx wrangler d1 create ramen-compare` の出力
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=

# 公開URL（canonical / OGP / sitemap / robots 用。本番では必須推奨）
# NEXT_PUBLIC_SITE_URL=https://example.com

# 任意: Google AdSense（審査通過後に設定）
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxx
