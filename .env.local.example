# HotPepper グルメサーチ API
# https://webservice.recruit.co.jp/ で取得
HOTPEPPER_API_KEY=

# Cloudflare D1（GitHub Actions / ローカルバッチの書き込み用）
# Account ID: ダッシュボード右サイドバー
# API Token: Workers / D1 編集権限（Account → API Tokens）
# Database ID: `npx wrangler d1 create ramen-compare` の出力
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=

# 公開URL（canonical / OGP / sitemap / robots 用。本番では必須推奨）
# NEXT_PUBLIC_SITE_URL=https://example.com

# 任意: Google AdSense（審査通過後に設定）
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxx

# アフィリエイト提供元（rakuten | yahoo）。未指定時は yahoo
# AFFILIATE_PROVIDER=yahoo

# 楽天ウェブサービス（AFFILIATE_PROVIDER=rakuten）
# https://webservice.rakuten.co.jp/
# RAKUTEN_APPLICATION_ID=
# RAKUTEN_ACCESS_KEY=
# RAKUTEN_AFFILIATE_ID=

# Yahoo!ショッピング商品検索 API v3（AFFILIATE_PROVIDER=yahoo）
# https://developer.yahoo.co.jp/webapi/shopping/v3/itemsearch.html
# YAHOO_CLIENT_ID=  # appid のみ Secrets/環境変数。VC の sid/pid は src/lib/site.ts 定数

# 開発時のみ: R2 欠損時に読むローカル JSON（未設定時は output/affiliate-products.json）
# "0" または "false" で無効（sample にフォールバック）。本番では無視される
# AFFILIATE_LOCAL_FILE=output/affiliate-products.json
